{
  "permissions": {
    "allow": [
      "Bash(cargo test *)",
      "Bash(git stash *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | grep -qE '\\.rs$' && cargo clippy --workspace 2>&1",
            "timeout": 120,
            "statusMessage": "Running cargo clippy..."
          }
        ]
      }
    ]
  }
}
