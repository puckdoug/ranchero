{
  "permissions": {
    "allow": [
      "Bash(cargo *)",
      "Bash(git stash *)",
      "Bash(wait)",
      "Bash(git checkout *)",
      "Bash(python3 *)",
      "Bash(ps -p 28552 -o stat,etime)"
    ],
    "deny": [
      "Bash(git commit)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | grep -qE '\\.rs$' && cargo clippy --workspace --all-targets --all-features -- -D warnings 2>&1",
            "timeout": 120,
            "statusMessage": "Running cargo clippy..."
          }
        ]
      }
    ]
  }
}
